Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"uy", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Exp", "[", "x", "]"}]}], 
     RowBox[{"Sin", "[", 
      RowBox[{"y", " ", "-", " ", "0.5"}], "]"}]}]}], ";"}], " "}], "\n", 
 RowBox[{"exacty", "=", 
  RowBox[{"DensityPlot", "[", 
   RowBox[{
    RowBox[{"uy", "[", 
