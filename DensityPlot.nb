Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"uy2", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"x", " ", "*", " ", "y"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"exacty2", "=", 
  RowBox[{"DensityPlot", "[", 
   RowBox[{
    RowBox[{"uy2", "[", 
     RowBox[{"x", ",", "y"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "4"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", "0", ",", "3"}], "}"}], ",", 
    RowBox[{"RegionFunction", "->", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"0", "<=", "x", "<=", "4"}], "&&", 
          RowBox[{"0", "<=", "y", "<=", "1"}]}], ")"}], "||", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"0", "<=", "x", "<=", "2"}], "&&", 
          RowBox[{"1", "<=", "y", "<=", "3"}]}], ")"}]}]}], "]"}]}], ",", 
    RowBox[{"Mesh", "->", "None"}], ",", 
    RowBox[{"ColorFunction", "->", "\"\<SunsetColors\>\""}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"Axes", "->", "False"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
    RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
    RowBox[{"PlotRange", "->", "All"}], ",", 
    RowBox[{"BoundaryStyle", "->", 
     RowBox[{"{", 
      RowBox[{"Black", ",", 
       RowBox[{"AbsoluteThickness", "[", "1.2", "]"}]}], "}"}]}], ",", 
    RowBox[{"PlotPoints", "->", "60"}], ",", 
    RowBox[{"MaxRecursion", "->", "2"}], ",", 
    RowBox[{"Epilog", "->", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"Dashed", ",", 
        RowBox[{"GrayLevel", "[", "0.2", "]"}], ",", 
        RowBox[{"AbsoluteThickness", "[", "1", "]"}], ",", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "1"}], "}"}]}], "}"}], "]"}]}], "}"}], 
      "}"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Export", "[", 
  RowBox[{"\"\<exacty_dif_bodies.pdf\>\"", ",", " ", "exacty2"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9837796550374804`*^9, 3.983779664277077*^9}, 
   3.9837811665097284`*^9, {3.9837844519867153`*^9, 3.9837844558799796`*^9}, {
