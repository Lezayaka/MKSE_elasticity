Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ux", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Exp", "[", "x", "]"}], 
     RowBox[{"Cos", "[", 
      RowBox[{"y", " ", "-", " ", "0.5"}], "]"}]}]}], ";"}], " "}], "\n", 
 RowBox[{"exactx", "=", 
  RowBox[{"DensityPlot", "[", 
   RowBox[{
    RowBox[{"ux", "[", 
     RowBox[{"x", ",", "y"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", "0", ",", "1"}], "}"}], ",", 
    RowBox[{"Mesh", "->", "None"}], ",", 
    RowBox[{"ColorFunction", "->", "\"\<SunsetColors\>\""}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"Axes", "->", "False"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
