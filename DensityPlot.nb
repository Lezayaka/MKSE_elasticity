Cell[BoxData[{
 RowBox[{
  RowBox[{"e", " ", "=", " ", 
   RowBox[{"21", " ", "*", " ", 
    SuperscriptBox["10", "10"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nu", " ", "=", " ", "0.3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mu", "=", 
   RowBox[{"e", "/", 
    RowBox[{"(", 
     RowBox[{"2", "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", "nu"}], ")"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lambda", "=", 
   RowBox[{"e", "*", 
    RowBox[{"nu", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", "nu"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"2", "*", "nu"}]}], ")"}]}], ")"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9837793273335037`*^9, 3.9837793610023394`*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"e470c7a9-e248-479b-9816-6718cbbd4b4c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"reg", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"0", "<=", "x", "<=", "4"}], "&&", 
     RowBox[{"0", "<=", "y", "<=", "1"}]}], ")"}], "||", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"0", "<=", "x", "<=", "2"}], "&&", 
     RowBox[{"1", "<=", "y", "<=", "3"}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.9837796095266347`*^9, 3.9837796095266347`*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"ad77ed72-3e2b-44b1-9044-8af106c3b1dd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ux2", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"lambda", "+", 
           RowBox[{"2.0", "*", "mu"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"2.0", "*", "lambda"}], ")"}]}], ")"}]}], "*", "x", "*", 
      "x"}], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"4.0", "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"lambda", "+", "mu"}], ")"}], "/", "lambda"}]}], ")"}], "*",
       "y"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"3.0", "*", "lambda"}], "+", 
          RowBox[{"4.0", "*", "mu"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"2.0", "*", "lambda"}], ")"}]}], ")"}], "*", "y", "*", 
      "y"}]}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"exactx2", "=", 
  RowBox[{"DensityPlot", "[", 
   RowBox[{
    RowBox[{"ux2", "[", 
     RowBox[{"x", ",", "y"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "4"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", "0", ",", "3"}], "}"}], ",", 
    RowBox[{"RegionFunction", "->", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"0", "<=", "x", "<=", "4"}], "&&", 
          RowBox[{"0", "<=", "y", "<=", "1"}]}], ")"}], "||", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"0", "<=", "x", "<=", "2"}], "&&", 
          RowBox[{"1", "<=", "y", "<=", "3"}]}], ")"}]}]}], "]"}]}], ",", 
    RowBox[{"Mesh", "->", "None"}], ",", 
    RowBox[{"ColorFunction", "->", "\"\<SunsetColors\>\""}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"Axes", "->", "False"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
    RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
    RowBox[{"PlotRange", "->", "All"}], ",", 
    RowBox[{"BoundaryStyle", "->", 
     RowBox[{"{", 
      RowBox[{"Black", ",", 
       RowBox[{"AbsoluteThickness", "[", "1.2", "]"}]}], "}"}]}], ",", 
    RowBox[{"PlotPoints", "->", "60"}], ",", 
    RowBox[{"MaxRecursion", "->", "2"}], ",", 
    RowBox[{"Epilog", "->", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"Dashed", ",", 
        RowBox[{"GrayLevel", "[", "0.2", "]"}], ",", 
        RowBox[{"AbsoluteThickness", "[", "1", "]"}], ",", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "1"}], "}"}]}], "}"}], "]"}]}], "}"}], 
      "}"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Export", "[", 
  RowBox[{"\"\<exactx_dif_bodies.pdf\>\"", ",", " ", "exactx2"}], 
  "]"}]}], "Input",
