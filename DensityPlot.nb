Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"uy", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Exp", "[", "x", "]"}]}], 
     RowBox[{"Sin", "[", 
      RowBox[{"y", " ", "-", " ", "0.5"}], "]"}]}]}], ";"}], " "}], "\n", 
 RowBox[{"exacty", "=", 
  RowBox[{"DensityPlot", "[", 
   RowBox[{
    RowBox[{"uy", "[", 
     RowBox[{"x", ",", "y"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", "0", ",", "1"}], "}"}], ",", 
    RowBox[{"Mesh", "->", "None"}], ",", 
    RowBox[{"ColorFunction", "->", "\"\<SunsetColors\>\""}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"Axes", "->", "False"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
    RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
    RowBox[{"PlotRange", "->", "All"}], ",", 
    RowBox[{"Epilog", "->", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"Dashed", ",", 
        RowBox[{"GrayLevel", "[", "0.2", "]"}], ",", 
        RowBox[{"AbsoluteThickness", "[", "1", "]"}], ",", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0.5"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "0.5"}], "}"}]}], "}"}], "]"}]}], "}"}], 
      "}"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Export", "[", 
  RowBox[{"\"\<exacty.pdf\>\"", ",", " ", "exacty"}], "]"}]}], "Input",
